# ---------------------------------------------------------------------------
# ConstructIQ backend configuration
# Copy this file to backend/.env and edit the values you need.
# ---------------------------------------------------------------------------

APP_NAME="ConstructIQ API"
APP_VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=false

# CORS origins (comma separated). Add your deployed frontend URL in production.
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# AI provider: auto | gemini | openai | demo
# auto = use Gemini if GEMINI_API_KEY is set, else OpenAI if OPENAI_API_KEY is set,
#        otherwise deterministic demo engine (no network / no key required).
AI_PROVIDER="auto"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
OPENAI_BASE_URL="https://api.openai.com/v1"
AI_TIMEOUT_SECONDS=60
AI_MAX_OUTPUT_TOKENS=3000

# Uploads
MAX_UPLOAD_MB=8
MAX_IMAGE_EDGE_PX=1280

# Weather (Open-Meteo needs no key). Set to "offline" to force demo weather.
WEATHER_PROVIDER="auto"
WEATHER_TIMEOUT_SECONDS=12
WEATHER_CACHE_SECONDS=600
